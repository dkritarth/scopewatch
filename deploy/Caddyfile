# Caddy reverse proxy for the Scopewatch hosted demo (issue #42).
#
# - Automatic TLS: Caddy obtains and renews a Let's Encrypt certificate for
#   {$DOMAIN} (requires DNS A/AAAA -> VM IP and ports 80+443 reachable).
#   For a bare IP or `localhost` Caddy serves plain HTTP automatically.
# - The `gate` applies edge controls, then the gateway independently validates
#   the forwarded demo token and applies its native guards. Caddy stays dumb:
#   TLS + compression + proxy.
# - Caddy adds X-Forwarded-For automatically; the gate trusts its first
#   entry for per-IP rate limiting. On the public internet that is sound
#   because the only reachable copy of the gate is the one behind Caddy: the
#   host publishes it on 127.0.0.1 only (#107), for the operator's own
#   runbook verify commands, and `127.0.0.1:` is not routable from outside
#   the VM. Anything running ON the VM can reach :8080 directly and spoof
#   that header, which is acceptable because it already owns the host.
{
	# Keep the admin API off the network (default listens on :2019).
	admin off
}

{$DOMAIN} {
	reverse_proxy gate:8080

	encode gzip

	# Static dashboard assets cache briefly; API responses never cache.
	# (The gate passes gateway Cache-Control through; this only adds edge
	# caching for immutable frontend files.)
	@static {
		path /styles/* /scripts/*
	}
	header @static Cache-Control "public, max-age=3600"

	log {
		output stdout
		format console
	}
}

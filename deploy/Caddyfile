# Caddy reverse proxy for the Scopewatch hosted demo (issue #42).
#
# - Automatic TLS: Caddy obtains and renews a Let's Encrypt certificate for
#   {$DOMAIN} (requires DNS A/AAAA -> VM IP and ports 80+443 reachable).
#   Use DOMAIN=http://localhost for a local plain-HTTP dry-run.
# - The gateway owns demo authentication, limits and token budgets.
# - Caddy replaces untrusted incoming X-Forwarded-For by default. The
#   unpublished gateway trusts this header for its per-IP rate limiter.
{
	# Keep the admin API off the network (default listens on :2019).
	admin off
}

{$DOMAIN} {
	reverse_proxy gateway:8000

	encode gzip

	# Static dashboard assets cache briefly; API responses never cache.
	# (API Cache-Control passes through; this only adds edge
	# caching for immutable frontend files.)
	@static {
		path /styles/* /scripts/*
	}
	header @static Cache-Control "public, max-age=3600"

	log {
		output stdout
		format console
	}
}

# Caddy reverse proxy for the Scopewatch hosted demo (issue #42).
#
# - Automatic TLS: Caddy obtains and renews a Let's Encrypt certificate for
#   {$DOMAIN} (requires DNS A/AAAA -> VM IP and ports 80+443 reachable).
#   For a bare IP or `localhost` Caddy serves plain HTTP automatically.
# - All demo access control lives in the `gate` service (demo token, rate
#   limits, caps, budget). Caddy stays dumb: TLS + compression + proxy.
# - Caddy adds X-Forwarded-For automatically; the gate trusts its first
#   entry for per-IP rate limiting (gate only listens on the internal
#   `public` compose network, so clients cannot spoof it past Caddy).
{
	# Keep the admin API off the network (default listens on :2019).
	admin off
}

{$DOMAIN} {
	reverse_proxy gate:8080

	encode gzip

	# Static dashboard assets cache briefly; API responses never cache.
	# (The gate passes gateway Cache-Control through; this only adds edge
	# caching for immutable frontend files.)
	@static {
		path /styles/* /scripts/*
	}
	header @static Cache-Control "public, max-age=3600"

	log {
		output stdout
		format console
	}
}

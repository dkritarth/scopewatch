# Scopewatch hosted-demo configuration (issue #42).
# Copy to `.env` NEXT TO this file (deploy/.env) on the VM and fill in real
# values there. NEVER commit the filled-in file: deploy/.env is gitignored.
# All values below are synthetic placeholders, safe to commit.
#
# Follows the pattern of the repo-root .env.example (provider profiles +
# API keys) and adds the demo-hosting knobs consumed by deploy/compose.yaml.

# --- Public address -------------------------------------------------------
# DNS name pointing at the VM (Caddy gets automatic TLS for it).
# Local dry-run without TLS: DOMAIN=http://localhost (plain HTTP).
DOMAIN=demo.example.com

# --- Demo access token (REQUIRED) -----------------------------------------
# Shared secret for judges, published ONLY in the submission's testing
# instructions. Mutating /api/* calls need it as the X-Demo-Token header.
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
DEMO_TOKEN=change-me-to-a-long-random-value

# --- Remote executor (only when the sidecar compose fragment is enabled) ---
# Default is `local`: actions execute in-process in the gateway container,
# which mounts no Docker socket. `docker` and `remote` require the sidecar
# fragment (deploy/executor-runner/compose.executor-runner.yaml) merged into
# the project; `remote` sends policy-approved dispatches to it over the
# runner-only `executor-runner` network.
# This used to be pinned in compose.yaml under `environment:`, which overrides
# env_file, so setting it here did nothing (issue #202). It is now read.
# EXECUTOR_RUNNER_URL defaults to http://executor-runner:8091.
SCOPEWATCH_EXECUTOR=local
# Generate two independent values with secrets.token_urlsafe(32).
EXECUTOR_RUNNER_TOKEN=
EXECUTOR_RUNNER_SIGNING_KEY=

# --- Provider profiles ----------------------------------------------------
# Live agent/auditor models. `mock` makes no model calls (scripted demo).
# Live demo: SCOPEWATCH_AGENT_PROFILE=nebius-demo (NVIDIA Nemotron via
# Nebius) with NEBIUS_API_KEY set below.
SCOPEWATCH_AGENT_PROFILE=mock
SCOPEWATCH_AUDITOR_PROFILE=mock

# --- Per-run workspaces (issue #117) ---------------------------------------
# Every run gets its OWN copy of the scenario workspace, so two runs can never
# read or overwrite each other's files, and container output lands in that run's
# copy instead of the shared fixture. The copy source (`/workspace`) stays
# pristine.
#
# This is NOT an operator knob, so it is deliberately absent from this file.
# The in-container paths below are a two-sided contract between the gateway and
# the executor-runner sidecar, and a half-changed value is a silent outage:
#
#   gateway   SCOPEWATCH_RUN_WORKSPACES_DIR=/runs  (deploy/compose.yaml)
#   runner    EXECUTOR_RUNNER_WORKSPACE=/runs       (compose.executor-runner.yaml)
#   volume    scopewatch-run-workspaces -> /runs    in BOTH services
#
# Change one and the demo breaks two different ways:
#   * gateway path not writable  -> the gateway aborts on first start (the
#     entrypoint seeds under `set -euo pipefail`) and every create_run then 503s
#     RUN_WORKSPACES_ROOT_UNAVAILABLE;
#   * gateway path != runner path -> the remote executor resolves no such
#     directory and every remote dispatch fails closed with 500.
#
# To relocate it, edit those values in the two compose files together and keep
# the volume mounted at the same path in both. Regression tests for all of this
# live in backend/tests/test_run_workspaces_deployment.py.

# --- API keys (only the ones your profiles reference) ---------------------
NEBIUS_API_KEY=
OPENROUTER_API_KEY=

# --- Gateway tuning -------------------------------------------------------
SCOPEWATCH_APPROVAL_TTL=300

# --- Demo abuse + cost controls (enforced by the gateway) ------------
# Max simultaneously active runs before new run creation is refused.
DEMO_MAX_CONCURRENT_RUNS=5
# Max action submissions (turns) per run.
DEMO_MAX_TURNS_PER_RUN=40
# Max run creations per IP per minute.
DEMO_RATE_LIMIT_RUNS_PER_MIN_PER_IP=6
# Daily demo budgets (UTC day). Conservative proxy for model cost; see
# docs/operations/demo-guards.md and RUNBOOK.md. Scripted (mock) scenarios make no
# model calls and are unaffected by provider spend.
DEMO_MAX_RUNS_PER_DAY=200
DEMO_MAX_ACTIONS_PER_DAY=5000

# Per-profile model-token budget, separate from run/action request counts.
# Unset means unlimited. Use the suffix of the configured provider profile.
# SCOPEWATCH_DAILY_TOKEN_BUDGET_NEBIUS_DEMO=1000000
# Persist token counts on the existing writable data volume if desired:
# SCOPEWATCH_TOKEN_BUDGET_STORE=/data/token-budget.json

# --- API & Reviewer Authentication (issue #185) ----------------------------
# Separate credentials for agent execution and human reviewer approval.
# Agents submitting actions use API_KEY (sent via X-API-Key header).
# Human reviewers resolving holds use REVIEWER_TOKEN (sent via X-Reviewer-Token).
# An agent credential CANNOT approve its own holds (403 refused).
# If left empty, local/dev mode operates with open access (zero keys required).
# API_KEY=change-me-to-agent-api-key
# REVIEWER_TOKEN=change-me-to-reviewer-token
# DEFAULT_REVIEWER_IDENTITY=reviewer-admin

# --- CORS & Origin Controls (issue #185) -----------------------------------
# By default, CORS is restricted to same-origin only (empty list []).
# Specify JSON array or comma-separated list of allowed origins if cross-origin
# dashboard hosting is needed. Never reflects evil origins with credentials.
# CORS_ALLOW_ORIGINS=["https://demo.example.com"]
# CORS_ALLOW_CREDENTIALS=false

# --- Demo Reset Controls (issue #185) --------------------------------------
# Guard /demo/reset endpoint against unauthorized state wipes.
# Defaults to false (403 forbidden). Set to true only during demo/testing.
# Requires REVIEWER_TOKEN when auth is configured.
SCOPEWATCH_ALLOW_RESET=false

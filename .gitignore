# Credentials and local configuration
.env
.env.*
!.env.example
*.pem
*.key

# Dependencies and generated output
node_modules/
.venv/
venv/
__pycache__/
*.py[cod]
dist/
build/
.next/
coverage/
.pytest_cache/

# Private runtime artifacts
traces/
logs/
*.log
runtime-data/
*.sqlite3
*.db

# Per-run workspace copies (#117). The default root is `.runs/` INSIDE each
# scenario fixture (workspaces.py: default_run_workspaces_root), and
# scripts/run_demo.sh writes to runtime-data/. Both are runtime state.
# Anchored to those two paths on purpose: a bare `*-runs/` would silently
# ignore any directory ending in "-runs" at any depth, so
# backend/tests/fixtures/foo-runs/ became untrackable and a real fixture
# directory could be dropped without a diff.
demo/workspace/.runs/
runtime-data/

# Local editor and OS state
.idea/
.vscode/
.DS_Store
Thumbs.db

# Environment variables for Scopewatch local development

# Provider profiles (e.g. mock, openrouter-dev, nebius-demo)
SCOPEWATCH_AUDITOR_PROFILE=mock
SCOPEWATCH_AGENT_PROFILE=mock

# API Keys (optional for live provider testing, not needed for mock)
OPENROUTER_API_KEY=
NEBIUS_API_KEY=

# Remote executor, when configured. Use two independent random secrets.
EXECUTOR_RUNNER_TOKEN=
EXECUTOR_RUNNER_SIGNING_KEY=

# Gateway-native demo guards (issues #76 / #77). Demo mode engages when
# DEMO_TOKEN is set (same names as deploy/.env.example); all values below are
# empty placeholders. See docs/operations/demo-guards.md.
DEMO_TOKEN=
DEMO_MAX_CONCURRENT_RUNS=
DEMO_MAX_TURNS_PER_RUN=
DEMO_RATE_LIMIT_RUNS_PER_MIN_PER_IP=
DEMO_MAX_RUNS_PER_DAY=
DEMO_MAX_ACTIONS_PER_DAY=

# Per-profile daily token budgets (UTC day, counts only). Unset = unlimited.
# Example for one profile: SCOPEWATCH_DAILY_TOKEN_BUDGET_NEBIUS_DEMO=
SCOPEWATCH_DAILY_TOKEN_BUDGET_NEBIUS_DEMO=
SCOPEWATCH_DAILY_TOKEN_BUDGET_OPENROUTER_DEV=
SCOPEWATCH_TOKEN_BUDGET_DEFAULT=
SCOPEWATCH_TOKEN_RESERVE_PER_AUDIT=
SCOPEWATCH_TOKEN_BUDGET_STORE=
